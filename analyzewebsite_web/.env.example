# Copy to .env for local development. On Railway, set these in
# your service -> Variables instead (never commit real keys).

ANTHROPIC_API_KEY=sk-ant-...

# --- Analysis result emails (Resend) -------------------------------------
# Omit RESEND_API_KEY to disable notification entirely; everything else
# keeps working.
RESEND_API_KEY=re_...

# Comma-separated. Defaults to Info@tencapital.group when unset.
ANALYSIS_EMAIL_TO=Info@tencapital.group

# Must be an address on a domain verified at resend.com/domains.
# tencapital.group is verified, so any local part on it works.
# Defaults to analyzer@tencapital.group when unset.
ANALYSIS_EMAIL_FROM=TEN Capital Website Analyzer <analyzer@tencapital.group>

# Optional, comma-separated.
ANALYSIS_EMAIL_CC=
